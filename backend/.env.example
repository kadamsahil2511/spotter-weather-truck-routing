DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
# Leave blank to run on the straight-line fixture. Never commit a real key.
ORS_API_KEY=
# Directions host. Default is the current HeiGIT path. If that host fails, the
# deprecated fallback is https://api.openrouteservice.org (same /v2/directions suffix).
ORS_BASE_URL=https://api.heigit.org/openrouteservice
# ors (default when a key is set), fixture, or osrm
ROUTING_PROVIDER=
# Optional. Unset uses the in-process cache.
REDIS_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
