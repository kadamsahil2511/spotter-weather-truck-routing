# Copy to .env next to docker-compose.yml for a local stack.
# On the VPS this file lives outside the clone at /opt/fs-truck/.env.
# Placeholder values only. Do not commit real secrets.
# docker compose sets DJANGO_DEBUG=0, so DJANGO_SECRET_KEY must not be one of
# the placeholders below or the process will refuse to start.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=fsapi.kadamsahil.com,127.0.0.1,localhost
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
CORS_ALLOWED_ORIGINS=https://fs.kadamsahil.com
ROUTING_PROVIDER=ors
ORS_BASE_URL=https://api.heigit.org/openrouteservice
ORS_API_KEY=your-ors-api-key

# Set by docker-compose.yml; listed here so the names stay in one place:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS is what settings read; ALLOWED_HOSTS is the fallback
# REDIS_URL=redis://redis:6379/0
